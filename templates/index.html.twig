{% extends 'base.html.twig' %}

{% block body %}
    <div class="container">
        <div class="row mt-5">
            <div class="col bg-darkblue rounded-5">
                <div class="row">
                    <div class="col-4 text-white weather-background-image">
                        <div class="row m-4">
                            <div class="col">
                                <p class="fs-1 mb-0">{{ data.region }}</p>
                                <p class="fs-4 mb-0">{{ data.dateTime|date("d F Y", "Europe/Amsterdam") }}</p> {# todo: translate #}
                            </div>
                        </div>
                        <div class="row mx-4 text-center">
                            <div class="col">
                                <p class="fs-h-1">{{ data.temperature }}&deg;</p>
                                <p class="fs-1">{{ data.shortDescription }}</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-8 bg-lighterblue rounded-5">
                        <div class="row">
                            <div class="col m-4">
                                <p class="fs-2">{{ data.title }}</p>
                                <p>{{ data.longDescription }}</p>
                                <div class="bg-white rounded-5">
                                    <div class="d-flex justify-content-between text-black-50 px-4 pt-4">
                                        <div class="d-flex flex-column align-items-center data-point">
                                            <span>Nu</span>
                                            <span class="fs-4">6&deg;</span>
                                        </div>
                                        <div class="d-flex flex-column align-items-center data-point">
                                            <span>11:00</span>
                                            <span class="fs-4">7&deg;</span>
                                        </div>
                                        <div class="d-flex flex-column align-items-center data-point">
                                            <span>12:00</span>
                                            <span class="fs-4">8&deg;</span>
                                        </div>
                                        <div class="d-flex flex-column align-items-center data-point">
                                            <span>13:00</span>
                                            <span class="fs-4">8&deg;</span>
                                        </div>
                                        <div class="d-flex flex-column align-items-center data-point">
                                            <span>14:00</span>
                                            <span class="fs-4">9&deg;</span>
                                        </div>
                                    </div>
                                    <div style="height: 200px">
                                        <canvas id="rainChart" data-rainData="{{ data.rainForecast.toJson|json_encode }}" class="px-4 py-2"></canvas>
                                    </div>
                                    <div class="d-flex justify-content-between text-black-50 px-4 pb-4">
                                        <div class="d-flex flex-column align-items-center data-point">
                                            <span>1mm</span>
                                        </div>
                                        <div class="d-flex flex-column align-items-center data-point">
                                            <span>2mm</span>
                                        </div>
                                        <div class="d-flex flex-column align-items-center data-point">
                                            <span>0mm</span>
                                        </div>
                                        <div class="d-flex flex-column align-items-center data-point">
                                            <span>0mm</span>
                                        </div>
                                        <div class="d-flex flex-column align-items-center data-point">
                                            <span>2mm</span>
                                        </div>
                                    </div>
                                </div>
                                <p class="mt-4 fs-2">Details</p>
                                <div class="row text-center">
                                    <div class="col-4">
                                        <div class="bg-white rounded-4 h-100 p-3">
                                            <p class="fs-4 mb-0">Gevoelstemperatuur</p>
                                            <p class="fs-5 fw-bold">{{ data.feelTemperature }}&deg;</p>
                                            <div class="d-flex justify-content-between text-black-50">
                                                <span>0&deg;</span>
                                                <span>10&deg;</span>
                                                <span>20&deg;</span>
                                                <span>30&deg;</span>
                                            </div>
                                            <div class="progress">
                                                {# todo, calc bar progress #}
                                                <div class="progress-bar progress-bar-blue" role="progressbar" style="width: 25%;" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100"></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="bg-white rounded-4 h-100">
                                            <p class="fs-4 mb-0">Windkracht</p>
                                            <div class="pb-4" style="width:100%; margin-top: -25%; margin-bottom: -25%">
                                                <canvas id="windChart" data-windSpeed="{{ data.windSpeed|json_encode }}" class="px-4 py-4"></canvas>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="bg-white rounded-4 h-100 p-3">
                                            <p class="fs-4 mb-0">Regen</p>
                                            <p class="fs-5 fw-bold">{{ data.rain }}mm/h</p>
                                            <div class="d-flex justify-content-around text-black-50">
                                                <span>1</span>
                                                <span>2</span>
                                                <span>3</span>
                                                <span>4</span>
                                                <span>5</span>
                                                <span>6</span>
                                                <span>7</span>
                                                <span>8</span>
                                                <span>9</span>
                                            </div>
                                            <div class="progress bg-transparent" style="height: 12px;">
                                                {# todo, calc bar progress #}
                                                <div class="progress-bar rounded-2 progress-bar-blue" role="progressbar" style="width: 8%"></div>
                                                <div class="progress-bar rounded-2 bg-transparent" role="progressbar" style="width: 3.5%"></div>
                                                <div class="progress-bar rounded-2 progress-bar-blue" role="progressbar" style="width: 8%"></div>
                                                <div class="progress-bar rounded-2 bg-transparent" role="progressbar" style="width: 3.5%"></div>
                                                <div class="progress-bar rounded-2 progress-bar-gray" role="progressbar" style="width: 8%"></div>
                                                <div class="progress-bar rounded-2 bg-transparent" role="progressbar" style="width: 3.5%"></div>
                                                <div class="progress-bar rounded-2 progress-bar-gray" role="progressbar" style="width: 8%"></div>
                                                <div class="progress-bar rounded-2 bg-transparent" role="progressbar" style="width: 3.5%"></div>
                                                <div class="progress-bar rounded-2 progress-bar-gray" role="progressbar" style="width: 8%"></div>
                                                <div class="progress-bar rounded-2 bg-transparent" role="progressbar" style="width: 3.5%"></div>
                                                <div class="progress-bar rounded-2 progress-bar-gray" role="progressbar" style="width: 8%"></div>
                                                <div class="progress-bar rounded-2 bg-transparent" role="progressbar" style="width: 3.5%"></div>
                                                <div class="progress-bar rounded-2 progress-bar-gray" role="progressbar" style="width: 8%"></div>
                                                <div class="progress-bar rounded-2 bg-transparent" role="progressbar" style="width: 3.5%"></div>
                                                <div class="progress-bar rounded-2 progress-bar-gray" role="progressbar" style="width: 8%"></div>
                                                <div class="progress-bar rounded-2 bg-transparent" role="progressbar" style="width: 3.5%"></div>
                                                <div class="progress-bar rounded-2 progress-bar-gray" role="progressbar" style="width: 8%"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row mt-4 text-center">
                                    <div class="col-4">
                                        <div class="bg-white rounded-4 h-100 p-3">
                                            <p class="fs-4 mb-0">Zonkracht</p>
                                            <p class="fs-5 fw-bold">{{ data.sunPower }}</p>
                                            {# todo, calc bar progress #}
                                            <div class="progress bg-transparent d-flex align-items-center justify-content-center" style="height: 36px;">
                                                <div class="progress-bar rounded-2 progress-bar-blue" role="progressbar" style="width: 16%; height: 20px;"></div>
                                                <div class="progress-bar rounded-2 bg-transparent" role="progressbar" style="width: 4%;  height: 20px;"></div>
                                                <div class="progress-bar rounded-2 progress-bar-gray" role="progressbar" style="width: 16%; height: 24px;"></div>
                                                <div class="progress-bar rounded-2 bg-transparent" role="progressbar" style="width: 4%; height: 24px;"></div>
                                                <div class="progress-bar rounded-2 progress-bar-gray" role="progressbar" style="width: 16%; height: 28px;"></div>
                                                <div class="progress-bar rounded-2 bg-transparent" role="progressbar" style="width: 4%; height: 28px;"></div>
                                                <div class="progress-bar rounded-2 progress-bar-gray" role="progressbar" style="width: 16%; height: 32px;"></div>
                                                <div class="progress-bar rounded-2 bg-transparent" role="progressbar" style="width: 4%; height: 32px;"></div>
                                                <div class="progress-bar rounded-2 progress-bar-gray" role="progressbar" style="width: 16%; height: 36px;"></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="bg-white rounded-4 h-100 p-3">
                                            <p class="fs-4 mb-0">Windrichting</p>
                                            <p class="fs-5 fw-bold mb-0">{{ data.windDirectionText }}</p>
                                            {# todo, make rotation dynamic #}
                                            <div class="d-inline-block rotate-135">
                                                <i class="bi bi-arrow-up-circle fs-h-5 text-blue"></i>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="bg-white rounded-4 h-100 p-3">
                                            <p class="fs-4">Gemeten om</p>
                                            <p class="fs-3 fw-bold">{{ data.dateTime|date('H:II', "Europe/Amsterdam") }}</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}