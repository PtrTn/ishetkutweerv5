{% extends 'base.html.twig' %}

{% block body %}
    <div class="container">
        <div class="row mt-lg-5">
            <div class="col bg-darkblue rounded-lg-5">
                <div class="row">
                    <div class="col-12 col-lg-4 text-white">
                        <div class="row m-4">
                            <div class="col text-center">
                                <p class="fs-1 mb-0">{{ data.region }}</p>
                                <p class="fs-4 mb-0">{{ data.dateTime|date("d F Y") }}</p>
                            </div>
                        </div>
                        <div class="row mx-4 mb-4 text-center">
                            <div class="col-6 col-lg-12  order-1 order-lg-1">
                                <p class="fs-h-1">{{ data.temperature }}&deg;</p>
                            </div>
                            <div class="col-12  order-3 order-lg-2">
                                <p class="fs-1">{{ data.shortDescription }}</p>
                            </div>
                            <div class="col-6 col-lg-12 order-2 order-lg-3">
                                <div class="d-flex align-items-center h-100">
                                    <img class="img-fluid w-100" src="/images/{{ data.weatherIcon.fileName }}"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-8 bg-lighterblue rounded-lg-5 text-center text-lg-start">
                        <div class="row">
                            <div class="col my-4 mx-lg-4">
                                <p class="fs-2">{{ data.title }}</p>
                                <p>{{ data.longDescription }}</p>
                                <div class="bg-white rounded-5">
                                    <div class="d-flex justify-content-between text-black-50 px-4 pt-4">
                                        {% for time, rain in data.rainForecast.dataPoints %}
                                            <div class="d-flex flex-column align-items-center data-point">
                                                <span>{{ time }}</span>
                                            </div>
                                        {% endfor %}
                                    </div>
                                    <div style="height: 200px">
                                        <canvas id="rainChart" data-rainData="{{ data.rainForecast.toJson|json_encode }}" class="px-4 py-2"></canvas>
                                    </div>
                                    <div class="d-flex justify-content-between text-black-50 px-4 pb-4">
                                        {% for time, rain in data.rainForecast.dataPoints %}
                                            <div class="d-flex flex-column align-items-center data-point">
                                                <span>{{ rain }}mm</span>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                                <p class="mt-4 fs-2">Details</p>
                                <div class="row text-center">
                                    <div class="col-12 col-xl-4 col-lg-6">
                                        <div class="bg-white rounded-4 h-100 p-3">
                                            <p class="fs-4 mb-0">Gevoels<wbr>temperatuur</p>
                                            <p class="fs-4 fw-bold">{{ data.feelTemperature }}&deg;</p>
                                            {% include 'components/progress-bar.html.twig' with { 'min': 0, 'max': 30, 'value': data.feelTemperature, 'unit': '°' } %}
                                        </div>
                                    </div>
                                    <div class="col-12 col-xl-4 col-lg-6 mt-4 mt-lg-0">
                                        <div class="bg-white rounded-4 h-100">
                                            <p class="fs-4 mb-0 pt-3">Windkracht</p>
                                            <div class="pb-4" style="width:100%; margin-top: -25%; margin-bottom: -25%">
                                                <canvas id="windChart" data-windSpeed="{{ data.windSpeed|json_encode }}" class="px-4 py-4"></canvas>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-xl-4 col-lg-6 mt-4 mt-xl-0">
                                        <div class="bg-white rounded-4 h-100 p-3">
                                            <p class="fs-4 mb-0">Regen</p>
                                            <p class="fs-4 fw-bold">{{ data.rain }}mm/h</p>
                                            {% include 'components/progress-dots.html.twig' with { 'min': 1, 'max': 9, 'value': data.rain } %}
                                        </div>
                                    </div>
                                    <div class="col-12 col-xl-4 col-lg-6 mt-4">
                                        <div class="bg-white rounded-4 h-100 p-3">
                                            <p class="fs-4 mb-0">Zonkracht</p>
                                            <p class="fs-4 fw-bold">{{ data.sunPower }}</p>
                                            {% include 'components/progress-stripes.html.twig' with { 'min': 1, 'max': 11, 'value': data.sunPower } %}
                                        </div>
                                    </div>
                                    <div class="col-12 col-xl-4 col-lg-6 mt-4">
                                        <div class="bg-white rounded-4 h-100 p-3">
                                            <p class="fs-4 mb-0">Windrichting</p>
                                            <p class="fs-4 fw-bold mb-0">{{ data.wind.directionText }}</p>
                                            <div class="d-inline-block" style="transform: rotate({{ data.wind.directionInDegrees }}deg)">
                                                <i class="bi bi-arrow-up-circle fs-h-5 text-blue"></i>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-xl-4 col-lg-6 mt-4">
                                        <div class="bg-white rounded-4 h-100 p-3">
                                            <p class="fs-4">Gemeten om</p>
                                            <p class="fs-3 fw-bold">{{ data.dateTime|date('H:i', "Europe/Amsterdam") }}</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}