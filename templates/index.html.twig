{% extends 'base.html.twig' %}

{% block body %}
    <div class="container">
        <div class="row mt-5">
            <div class="col bg-darkblue rounded-5">
                <div class="row">
                    <div class="col-4 text-white">
                        <div class="row m-4">
                            <div class="col">
                                <h3>Pijnacker</h3>
                                <p>18 november 2024</p>
                            </div>
                        </div>
                        <div class="row mx-4 text-center">
                            <div class="col">
                                <h2>10&deg;</h2>
                                <h4>Zonnig</h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-8 bg-lighterblue rounded-5">
                        <div class="row">
                            <div class="col m-4">
                                <h1>Hey Peter</h1>
                                <p>Todays weather for you</p>
                                <img class="img-fluid rounded-5" src="https://placehold.co/1000x400" alt="placeholder">
                                <p class="mt-4">Details</p>
                                <div class="row text-center">
                                    <div class="col-4 pr-2">
                                        <div class="bg-white rounded-4 p-3">
                                            <p class="fs-4 mb-0">Temperatuur</p>
                                            <p class="fs-5 fw-bold">8&deg;</p>
                                            <div class="d-flex justify-content-between">
                                                <span>0&deg;</span>
                                                <span>10&deg;</span>
                                                <span>20&deg;</span>
                                                <span>30&deg;</span>
                                            </div>
                                            <div class="progress">
                                                <div class="progress-bar progress-bar-blue" role="progressbar" style="width: 25%;" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100"></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-4 pr-2">
                                        <div class="bg-white rounded-4 p-3">
                                            <p class="fs-4 mb-0">Windkracht</p>
                                            <p class="fs-5 fw-bold">6 bft.</p>
                                            <div id="gauge5" class="gauge-container five"></div>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="bg-white rounded-4 p-3">
                                            <p class="fs-4 mb-0">Regen</p>
                                            <p class="fs-5 fw-bold">2mm/h</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="row mt-4">
                                    <div class="col-4">
                                        <img class="img-fluid rounded-5" src="https://placehold.co/600x400" alt="placeholder">
                                    </div>
                                    <div class="col-4">
                                        <img class="img-fluid rounded-5" src="https://placehold.co/600x400" alt="placeholder">
                                    </div>
                                    <div class="col-4">
                                        <img class="img-fluid rounded-5" src="https://placehold.co/600x400" alt="placeholder">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}